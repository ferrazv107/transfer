CREATE COMPUTE MODULE gsc_inflow_messages_Compute_set_legnth
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
 
    	-- Input BLOB must be 16 digits
    	DECLARE source BLOB X'0000000000000006';
    	DECLARE target INT;
 
    	SET source =  X'000000000000' || SUBSTRING(InputRoot.BLOB.BLOB FROM 1 FOR 2);
    	SET target = CAST(source AS INT);
   
		-- SET OutputLocalEnvironment.TCPIP.Receive.Length = 43;
		---Faz a leitura do número de bytes por mensagem depois dos dois primeiros bytes
		SET OutputLocalEnvironment.TCPIP.Receive.Length = target;
		
		RETURN TRUE;   
	END;
 
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;

