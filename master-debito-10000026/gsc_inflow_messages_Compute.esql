CREATE COMPUTE MODULE gsc_inflow_messages_Compute

    CREATE FUNCTION Main() RETURNS BOOLEAN

    BEGIN

        DECLARE bitStreamGsc BLOB;

        DECLARE bitStreamIso BLOB;

        DECLARE bitStreamRsp BLOB;
 
        -- Copy message headers

        -- CALL CopyMessageHeaders();
        
        SET OutputRoot.Properties.CodedCharSetId = 500;
        SET OutputRoot.Properties.Encoding = 785;
        SET OutputRoot.MQMD.CodedCharSetId = 500;
        SET OutputRoot.MQMD.Encoding = 785;
--        SET OutputRoot.MQMD.Format = 'MQSTR   ';


        SET OutputRoot.DFDL.PROT00.PROT_COD_REDE = 'BROKER00';

        SET OutputRoot.DFDL.PROT00.PROT_CONTROLE_SESSAO.PROT_TIPO_MSG = '0';

        SET OutputRoot.DFDL.PROT00.PROT_CONTROLE_SESSAO.fill_3 = '0';




--        SET bitStreamGsc = ASBITSTREAM(OutputRoot.DFDL.PROT00, 785, 500, 'BLOB', '', '');
		SET bitStreamGsc = ASBITSTREAM(OutputRoot.DFDL.PROT00);
 
--        SET bitStreamIso = ASBITSTREAM(InputRoot.DFDL.ISO8583_1987, 785, 500, 'DFDL', '', '');
		SET bitStreamIso = ASBITSTREAM(InputRoot.DFDL.ISO8583_1987);

        SET bitStreamRsp = bitStreamGsc || bitStreamIso;

        SET OutputRoot.BLOB.BLOB = bitStreamRsp;


        DELETE FIELD OutputRoot.DFDL;
 
        RETURN TRUE;

    END;
 
    CREATE PROCEDURE CopyMessageHeaders() BEGIN

        DECLARE I INTEGER 1;

        DECLARE J INTEGER;

        SET J = CARDINALITY(InputRoot.*[]);

        WHILE I < J DO

            SET OutputRoot.*[I] = InputRoot.*[I];

            SET I = I + 1;

        END WHILE;

    END;
 
    CREATE PROCEDURE CopyEntireMessage() BEGIN

        SET OutputRoot = InputRoot;

    END;

END MODULE;